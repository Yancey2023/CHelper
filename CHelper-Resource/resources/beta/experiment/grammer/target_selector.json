{
  "id": "target_selector",
  "type": "grammar",
  "content": {
    "id": "target_selector",
    "node": [
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_at",
        "symbol": "@",
        "description": "目标选择器开始字符",
        "isAddSpace": false
      },
      {
        "type": "NORMAL_ID",
        "id": "selector_kind",
        "contents": [
          {
            "name": "e",
            "description": "选择所有实体(只选择活着的实体)"
          },
          {
            "name": "a",
            "description": "选择所有玩家(无论死活)"
          },
          {
            "name": "r",
            "description": "选择一名随机玩家(可通过type选择非玩家实体)(只选择活着的实体)"
          },
          {
            "name": "p",
            "description": "选择最近的玩家(只选择活着的玩家)"
          },
          {
            "name": "s",
            "description": "命令的执行者(只选择1个实体)(无论是否濒死)"
          },
          {
            "name": "n",
            "description": "选择最近的一个实体(只选择活着的实体)"
          },
          {
            "name": "initiator",
            "description": "当前与该NPC进行交互的玩家(在NPC内置的命令界面中使用)"
          }
        ]
      },
      {
        "type": "AND",
        "id": "selector_head",
        "nodes": [
          "symbol_at",
          "selector_kind"
        ]
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_lbracket",
        "symbol": "[",
        "description": "左方括号",
        "isAddSpace": false
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_equal",
        "symbol": "=",
        "description": "等于",
        "isAddSpace": false
      },
      {
        "type": "RELATIVE_FLOAT",
        "id": "value_relative_float",
        "description": "目标选择器参数(相对坐标)",
        "canUseCaretNotation": false
      },
      {
        "type": "FLOAT",
        "id": "value_float",
        "description": "目标选择器参数(小数)",
        "min": null,
        "max": null
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_lbrace",
        "symbol": "{",
        "description": "左花括号",
        "isAddSpace": false
      },
      {
        "type": "STRING",
        "id": "value_string_flexible",
        "description": "目标选择器参数(字符串)",
        "allowMissingString": true,
        "canContainSpace": true,
        "ignoreLater": false
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_not",
        "symbol": "!",
        "description": "不等于",
        "isAddSpace": false
      },
      {
        "type": "AND",
        "id": "operator_not_equal",
        "nodes": [
          "symbol_equal",
          "symbol_not"
        ]
      },
      {
        "type": "OR",
        "id": "operator_equal_or_not_equal",
        "nodes": [
          "operator_not_equal",
          "symbol_equal"
        ],
        "isUseFirst": false,
        "noSuggestion": false
      },
      {
        "type": "RANGE",
        "id": "value_score_range",
        "description": "目标选择器scores参数值的分数范围"
      },
      {
        "type": "AND",
        "id": "score_entry",
        "nodes": [
          "value_string_flexible",
          "operator_equal_or_not_equal",
          "value_score_range"
        ]
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_comma",
        "symbol": ",",
        "description": "分隔符",
        "isAddSpace": false
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_rbrace",
        "symbol": "}",
        "description": "右花括号",
        "isAddSpace": false
      },
      {
        "type": "LIST",
        "id": "scores_object",
        "left": "symbol_lbrace",
        "element": "score_entry",
        "separator": "symbol_comma",
        "right": "symbol_rbrace"
      },
      {
        "type": "NAMESPACE_ID",
        "id": "value_entity_id",
        "description": "实体",
        "key": "entity",
        "ignoreError": true
      },
      {
        "type": "STRING",
        "id": "value_family",
        "description": "族",
        "allowMissingString": false,
        "canContainSpace": false,
        "ignoreLater": false
      },
      {
        "type": "NAMESPACE_ID",
        "id": "value_item_id",
        "description": "物品ID",
        "key": "item",
        "ignoreError": true
      },
      {
        "type": "INTEGER",
        "id": "value_item_data",
        "description": "目标选择器hasitem参数物品数据值",
        "min": 0,
        "max": 32767
      },
      {
        "type": "RANGE",
        "id": "value_quantity_range",
        "description": "限制范围内的所有槽位中符合条件的物品的总和数量"
      },
      {
        "type": "STRING",
        "id": "value_inventory_location",
        "description": "物品栏",
        "allowMissingString": false,
        "canContainSpace": false,
        "ignoreLater": false
      },
      {
        "type": "RANGE",
        "id": "value_slot_range",
        "description": "要检测的槽位范围"
      },
      {
        "type": "EQUAL_ENTRY",
        "id": "hasitem_field",
        "values": [
          {
            "name": "item",
            "description": "要检测的物品",
            "canUseNotEqual": false,
            "value": "value_item_id"
          },
          {
            "name": "data",
            "description": "要检测的物品的数据值",
            "canUseNotEqual": false,
            "value": "value_item_data"
          },
          {
            "name": "quantity",
            "description": "限制范围内的所有槽位中符合条件的物品的总和数量",
            "canUseNotEqual": true,
            "value": "value_quantity_range"
          },
          {
            "name": "location",
            "description": "要检测的物品栏",
            "canUseNotEqual": false,
            "value": "value_inventory_location"
          },
          {
            "name": "slot",
            "description": "用于指定要检测的槽位范围",
            "canUseNotEqual": true,
            "value": "value_slot_range"
          }
        ]
      },
      {
        "type": "LIST",
        "id": "hasitem_object",
        "left": "symbol_lbrace",
        "element": "hasitem_field",
        "separator": "symbol_comma",
        "right": "symbol_rbrace"
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_rbracket",
        "symbol": "]",
        "description": "右方括号",
        "isAddSpace": false
      },
      {
        "type": "LIST",
        "id": "hasitem_array",
        "left": "symbol_lbracket",
        "element": "hasitem_object",
        "separator": "symbol_comma",
        "right": "symbol_rbracket"
      },
      {
        "type": "OR",
        "id": "hasitem_value",
        "nodes": [
          "hasitem_object",
          "hasitem_array"
        ],
        "isUseFirst": false,
        "noSuggestion": false
      },
      {
        "type": "NORMAL_ID",
        "id": "permission_state",
        "contents": [
          {
            "name": "enabled",
            "description": "启用"
          },
          {
            "name": "disabled",
            "description": "禁用"
          }
        ]
      },
      {
        "type": "EQUAL_ENTRY",
        "id": "permission_field",
        "values": [
          {
            "name": "camera",
            "description": "玩家能否转动相机视角",
            "canUseNotEqual": false,
            "value": "permission_state"
          },
          {
            "name": "movement",
            "description": "玩家能否移动",
            "canUseNotEqual": false,
            "value": "permission_state"
          }
        ]
      },
      {
        "type": "LIST",
        "id": "permission_object",
        "left": "symbol_lbrace",
        "element": "permission_field",
        "separator": "symbol_comma",
        "right": "symbol_rbrace"
      },
      {
        "type": "BOOLEAN",
        "id": "value_boolean",
        "description": "布尔值"
      },
      {
        "type": "OR",
        "id": "property_value",
        "nodes": [
          "value_boolean",
          "value_score_range",
          "value_string_flexible",
          "value_float"
        ],
        "isUseFirst": false,
        "noSuggestion": false
      },
      {
        "type": "AND",
        "id": "property_entry",
        "nodes": [
          "value_string_flexible",
          "operator_equal_or_not_equal",
          "property_value"
        ]
      },
      {
        "type": "LIST",
        "id": "property_object",
        "left": "symbol_lbrace",
        "element": "property_entry",
        "separator": "symbol_comma",
        "right": "symbol_rbrace"
      },
      {
        "type": "STRING",
        "id": "value_game_mode",
        "description": "游戏模式",
        "allowMissingString": false,
        "canContainSpace": false,
        "ignoreLater": false
      },
      {
        "type": "INTEGER",
        "id": "value_integer",
        "description": "目标选择器参数(整数)",
        "min": null,
        "max": null
      },
      {
        "type": "EQUAL_ENTRY",
        "id": "selector_argument",
        "values": [
          {
            "name": "x",
            "description": "x坐标",
            "canUseNotEqual": false,
            "value": "value_relative_float"
          },
          {
            "name": "y",
            "description": "y坐标",
            "canUseNotEqual": false,
            "value": "value_relative_float"
          },
          {
            "name": "z",
            "description": "z坐标",
            "canUseNotEqual": false,
            "value": "value_relative_float"
          },
          {
            "name": "r",
            "description": "最大半径",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "rm",
            "description": "最小半径",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "dx",
            "description": "x坐标差异(检查实体的腿部位置)",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "dy",
            "description": "y坐标差异(检查实体的腿部位置)",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "dz",
            "description": "z坐标差异(检查实体的腿部位置)",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "scores",
            "description": "分数",
            "canUseNotEqual": false,
            "value": "scores_object"
          },
          {
            "name": "tag",
            "description": "标签",
            "canUseNotEqual": true,
            "value": "value_string_flexible"
          },
          {
            "name": "name",
            "description": "名字",
            "canUseNotEqual": true,
            "value": "value_string_flexible"
          },
          {
            "name": "type",
            "description": "实体类型",
            "canUseNotEqual": true,
            "value": "value_entity_id"
          },
          {
            "name": "family",
            "description": "族",
            "canUseNotEqual": true,
            "value": "value_family"
          },
          {
            "name": "rx",
            "description": "最大垂直旋转",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "rxm",
            "description": "最小垂直旋转",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "ry",
            "description": "最大水平旋转",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "rym",
            "description": "最小水平旋转",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "hasitem",
            "description": "物品栏",
            "canUseNotEqual": false,
            "value": "hasitem_value"
          },
          {
            "name": "haspermission",
            "description": "权限",
            "canUseNotEqual": false,
            "value": "permission_object"
          },
          {
            "name": "has_property",
            "description": "属性",
            "canUseNotEqual": false,
            "value": "property_object"
          },
          {
            "name": "l",
            "description": "最大经验等级",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "lm",
            "description": "最小经验等级",
            "canUseNotEqual": false,
            "value": "value_float"
          },
          {
            "name": "m",
            "description": "游戏模式",
            "canUseNotEqual": true,
            "value": "value_game_mode"
          },
          {
            "name": "c",
            "description": "目标数量(按照距离排序)",
            "canUseNotEqual": false,
            "value": "value_integer"
          }
        ]
      },
      {
        "type": "LIST",
        "id": "selector_arguments",
        "left": "symbol_lbracket",
        "element": "selector_argument",
        "separator": "symbol_comma",
        "right": "symbol_rbracket"
      },
      {
        "type": "OPTIONAL",
        "id": "selector_arguments_optional",
        "node": "selector_arguments"
      },
      {
        "type": "AND",
        "id": "selector_expression",
        "nodes": [
          "selector_head",
          "selector_arguments_optional"
        ]
      },
      {
        "type": "STRING",
        "id": "player_name",
        "description": "玩家名字",
        "allowMissingString": false,
        "canContainSpace": true,
        "ignoreLater": false
      },
      {
        "type": "SINGLE_SYMBOL",
        "id": "symbol_star",
        "symbol": "*",
        "description": "所有正被记分板跟踪的实体",
        "isAddSpace": false
      },
      {
        "type": "OR",
        "id": "target_selector_root",
        "nodes": [
          "selector_expression",
          "player_name",
          "symbol_star"
        ],
        "isUseFirst": false,
        "noSuggestion": false
      }
    ],
    "start": "target_selector_root"
  }
}
