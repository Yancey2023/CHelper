{
    "name": [
        "msg",
        "tell",
        "w"
    ],
    "description": "向一个或多个玩家发送私聊消息。",
    "syntax": [
        "/tell <target: target> <message: message>"
    ],
    "node": {
        "<target: target>": {
            "type": "TARGET_SELECTOR",
            "description": "选择私聊消息的接收玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<message: message>": {
            "type": "STRING",
            "canContainSpace": true,
            "brief": "消息",
            "description": "指定要发送的私聊消息。",
            "ignoreLater": true
        }
    }
}