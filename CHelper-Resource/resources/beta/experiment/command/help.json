{
    "name": [
        "?",
        "help"
    ],
    "description": "获取可用命令列表或单个命令的帮助信息。",
    "syntax": [
        "/help <page: int>",
        "/help [command: CommandName]"
    ],
    "node": {
        "<page: int>": {
            "type": "INTEGER",
            "brief": "页码",
            "description": "显示指定页的可用命令列表。"
        },
        "[command: CommandName]": {
            "type": "COMMAND_NAME",
            "brief": "命令名",
            "description": "查询指定命令的帮助信息。"
        }
    }
}