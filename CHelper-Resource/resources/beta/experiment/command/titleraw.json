{
    "name": [
        "titleraw"
    ],
    "description": "控制屏幕标题。",
    "syntax": [
        "/titleraw <player: target> <titleLocation: TitleRawSet> <raw json titleText: json>",
        "/titleraw <player: target> clear",
        "/titleraw <player: target> reset",
        "/titleraw <player: target> times <fadeIn: int> <stay: int> <fadeOut: int>"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定屏幕标题操作的目标玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "目标玩家"
        },
        "<titleLocation: TitleRawSet>": {
            "type": "NORMAL_ID",
            "description": "指定屏幕标题的类型",
            "ignoreError": false,
            "contents": [
                {
                    "name": "title",
                    "description": "显示或修改屏幕标题。"
                },
                {
                    "name": "subtitle",
                    "description": "设置屏幕副标题文本。"
                },
                {
                    "name": "actionbar",
                    "description": "在动作栏显示文本。"
                }
            ],
            "brief": "标题类型"
        },
        "<raw json titleText: json>": {
            "type": "JSON",
            "brief": "标题JSON文本",
            "description": "指定标题、副标题、动作栏上方要显示的JSON文本。",
            "key": "rawtext"
        },
        "clear": {
            "type": "TEXT",
            "description": "清除指定玩家屏幕标题。",
            "data": {
                "name": "clear",
                "description": "清除指定玩家屏幕标题。"
            }
        },
        "reset": {
            "type": "TEXT",
            "description": "重置指定玩家屏幕标题的淡入、持续、淡出时间。",
            "data": {
                "name": "reset",
                "description": "重置指定玩家屏幕标题的淡入、持续、淡出时间。"
            }
        },
        "times": {
            "type": "TEXT",
            "description": "更改指定玩家屏幕标题的淡入、持续、淡出时间。",
            "data": {
                "name": "times",
                "description": "更改指定玩家屏幕标题的淡入、持续、淡出时间。"
            }
        },
        "<fadeIn: int>": {
            "type": "INTEGER",
            "brief": "标题淡入时长",
            "description": "指定标题淡入时长。 单位为游戏刻。"
        },
        "<stay: int>": {
            "type": "INTEGER",
            "brief": "标题持续时长",
            "description": "指定标题持续时长。 单位为游戏刻。"
        },
        "<fadeOut: int>": {
            "type": "INTEGER",
            "brief": "标题淡出时长",
            "description": "指定标题淡出时长。 单位为游戏刻。"
        }
    }
}