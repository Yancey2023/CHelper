{
    "name": [
        "locate"
    ],
    "description": "查找最近的结构、生物群系或兴趣点，并显示坐标和距离。",
    "syntax": [
        "/locate biome <biome: Biome>",
        "/locate poi <poi_type: poi type>",
        "/locate poi <tags: poi tag>",
        "/locate structure <structure: string> [useNewChunksOnly: Boolean]"
    ],
    "node": {
        "biome": {
            "type": "TEXT",
            "description": "按生物群系查找位置。",
            "data": {
                "name": "biome",
                "description": "按生物群系查找位置。"
            }
        },
        "<biome: Biome>": {
            "type": "NORMAL_ID",
            "brief": "生物群系",
            "description": "指定要定位的生物群系的命名空间ID或生物群系标签。",
            "ignoreError": true,
            "key": "biome"
        },
        "structure": {
            "type": "TEXT",
            "description": "按结构查找位置。",
            "data": {
                "name": "structure",
                "description": "按结构查找位置。"
            }
        },
        "<structure: string>": {
            "type": "NORMAL_ID",
            "brief": "结构",
            "description": "指定要定位的结构的命名空间ID或结构标签。",
            "ignoreError": true,
            "key": "structure"
        },
        "[useNewChunksOnly: Boolean]": {
            "type": "BOOLEAN",
            "brief": "查找范围",
            "description": "控制是否只在尚未生成的区块中查找结构。",
            "descriptionTrue": "只搜索尚未生成的区块。",
            "descriptionFalse": "也搜索已经生成的区块。"
        },
        "poi": {
            "type": "TEXT",
            "description": "按兴趣点类型查找位置。",
            "data": {
                "name": "poi",
                "description": "按兴趣点类型查找位置。"
            }
        },
        "<poi_type: poi type>": {
            "type": "STRING",
            "description": "要查找的兴趣点类型。",
            "canContainSpace": false,
            "ignoreLater": false
        },
        "<tags: poi tag>": {
            "type": "STRING",
            "description": "筛选兴趣点的标签。",
            "canContainSpace": false,
            "ignoreLater": false
        }
    }
}