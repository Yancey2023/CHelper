{
    "name": [
        "tellraw"
    ],
    "description": "向一个或多个玩家发送文本组件消息。",
    "syntax": [
        "/tellraw <target: target> <raw json message: json>"
    ],
    "node": {
        "<target: target>": {
            "type": "TARGET_SELECTOR",
            "description": "选择文本组件消息的接收玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<raw json message: json>": {
            "type": "JSON",
            "brief": "JSON文本",
            "description": "指定要发送的文本组件消息。",
            "key": "rawtext"
        }
    }
}