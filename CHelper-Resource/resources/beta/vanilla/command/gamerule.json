{
    "name": [
        "gamerule"
    ],
    "description": "设置或查询游戏规则。",
    "syntax": [
        "/gamerule",
        "/gamerule <rule: BoolGameRule> [value: Boolean]",
        "/gamerule <rule: IntGameRule> [value: int]",
        "/gamerule playerwaypoints <value: playerwaypointsValues>"
    ],
    "node": {
        "[value: Boolean]": {
            "type": "BOOLEAN",
            "brief": "游戏规则设置的值",
            "description": "指定要设置的游戏规则值。",
            "descriptionTrue": "将所选游戏规则的值设置为true。",
            "descriptionFalse": "将所选游戏规则的值设置为false。"
        },
        "[value: int]": {
            "type": "INTEGER",
            "brief": "游戏规则设置的值",
            "description": "指定要设置的游戏规则值。"
        },
        "<value: playerwaypointsValues>": {
            "type": "NORMAL_ID",
            "brief": "游戏规则值",
            "description": "指定游戏规则playerWaypoints设置的值。",
            "ignoreError": true,
            "contents": [
                {
                    "name": "off",
                    "description": "玩家不会在定位栏上显示。"
                },
                {
                    "name": "everyone",
                    "description": "所有玩家均会在定位栏上显示。"
                }
            ]
        },
        "<rule: BoolGameRule>": {
            "type": "NORMAL_ID",
            "brief": "要设置或查询的游戏规则",
            "description": "指定要设置或查询的游戏规则。",
            "ignoreError": false,
            "key": "gameRuleBoolean"
        },
        "<rule: IntGameRule>": {
            "type": "NORMAL_ID",
            "brief": "要设置或查询的游戏规则",
            "description": "指定要设置或查询的游戏规则。",
            "ignoreError": false,
            "key": "gameRuleInteger"
        },
        "playerwaypoints": {
            "type": "TEXT",
            "description": "查询或设置playerWaypoints游戏规则。",
            "data": {
                "name": "playerwaypoints",
                "description": "查询或设置playerWaypoints游戏规则。"
            }
        }
    }
}