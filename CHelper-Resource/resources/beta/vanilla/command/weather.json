{
    "name": [
        "weather"
    ],
    "description": "更改游戏中的天气。",
    "syntax": [
        "/weather <clear|rain|thunder> [duration: int]",
        "/weather query"
    ],
    "node": {
        "<clear|rain|thunder>": {
            "type": "NORMAL_ID",
            "description": "指定要设置的天气",
            "ignoreError": false,
            "contents": [
                {
                    "name": "clear",
                    "description": "将天气设为晴天。"
                },
                {
                    "name": "rain",
                    "description": "将天气设为雨天。"
                },
                {
                    "name": "thunder",
                    "description": "将天气设为雷暴雨。"
                }
            ],
            "brief": "天气类型"
        },
        "[duration: int]": {
            "type": "INTEGER",
            "brief": "天气的持续时间",
            "description": "指定天气的持续时间。 指定的时间以游戏刻为单位。",
            "min": 0,
            "max": 1000000
        },
        "query": {
            "type": "TEXT",
            "description": "也可用于显示当前天气。",
            "data": {
                "name": "query",
                "description": "也可用于显示当前天气。"
            }
        }
    }
}