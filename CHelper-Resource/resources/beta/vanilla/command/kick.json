{
    "name": [
        "kick"
    ],
    "description": "将玩家踢出服务器。",
    "syntax": [
        "/kick <name: target> [reason: message]"
    ],
    "node": {
        "<name: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定要踢出的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "要踢出的玩家"
        },
        "[reason: message]": {
            "type": "STRING",
            "description": "指定将显示给被踢出玩家的消息。",
            "canContainSpace": true,
            "ignoreLater": true,
            "brief": "将显示给被踢出玩家的消息"
        }
    }
}