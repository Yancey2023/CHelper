{
    "name": [
        "damage"
    ],
    "description": "对指定实体造成指定类型的伤害。",
    "syntax": [
        "/damage <target: target> <amount: int> <cause: DamageCause> entity <damager: target>",
        "/damage <target: target> <amount: int> [cause: DamageCause]"
    ],
    "node": {
        "<target: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定要被伤害的目标实体。",
            "isOnlyOne": false,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "要被伤害的目标实体"
        },
        "<amount: int>": {
            "type": "INTEGER",
            "min": 0,
            "brief": "要造成的伤害值",
            "description": "指定要造成的伤害值。"
        },
        "[cause: DamageCause]": {
            "type": "NORMAL_ID",
            "description": "指定伤害类型。",
            "ignoreError": true,
            "key": "damageCause",
            "brief": "伤害类型"
        },
        "<cause: DamageCause>": {
            "type": "NORMAL_ID",
            "description": "指定伤害类型。",
            "ignoreError": true,
            "key": "damageCause",
            "brief": "伤害类型"
        },
        "entity": {
            "type": "TEXT",
            "description": "指定伤害的直接来源实体。",
            "data": {
                "name": "entity",
                "description": "指定伤害的直接来源实体。"
            }
        },
        "<damager: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定伤害的直接来源实体。",
            "isOnlyOne": true,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "伤害来源实体"
        }
    }
}