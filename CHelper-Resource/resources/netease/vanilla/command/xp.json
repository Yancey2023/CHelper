{
    "name": [
        "xp"
    ],
    "description": "给予玩家经验值或调整经验等级。",
    "syntax": [
        "/xp <amount: int> [player: target]",
        "/xp <amount: int>L [player: target]"
    ],
    "node": {
        "<amount: int>L|<amount: int>": {
            "type": "INTEGER_WITH_UNIT",
            "brief": "经验值或等级数量",
            "description": "指定要给予玩家的经验值或经验等级的数量。 以L后缀指定经验等级，否则指定经验值。",
            "units": [
                {
                    "name": "L",
                    "description": "指定经验等级。"
                }
            ]
        },
        "[player: target]": {
            "type": "TARGET_SELECTOR",
            "description": "指定命令作用的目标玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "目标玩家"
        }
    }
}