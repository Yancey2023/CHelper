{
    "name": [
        "clear"
    ],
    "description": "清除玩家物品栏的物品。",
    "syntax": [
        "/clear [player: target] [itemName: Item] [data: int] [maxCount: int]"
    ],
    "node": {
        "[player: target]": {
            "type": "TARGET_SELECTOR",
            "description": "指定要被清除物品的玩家。如果未指定，默认为命令执行者。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "[itemName: Item] [data: int] [maxCount: int]": {
            "type": "ITEM",
            "description": "指定要被清除的物品。如果未指定，默认为所有物品。",
            "nodeItemType": 1
        }
    }
}