{
    "name": [
        "hud"
    ],
    "description": "修改HUD的可见性。",
    "syntax": [
        "/hud <target: target> <visible: HudVisibility> [hud_element: HudElement]"
    ],
    "node": {
        "<target: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定将被修改HUD可见性的目标。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<visible: HudVisibility>": {
            "type": "NORMAL_ID",
            "brief": "可见性",
            "description": "指定将对HUD可见性做出的修改。",
            "ignoreError": false,
            "contents": [
                {
                    "name": "hide",
                    "description": "隐藏指定的HUD元素。"
                },
                {
                    "name": "reset",
                    "description": "恢复指定HUD元素的默认显示状态。"
                }
            ]
        },
        "[hud_element: HudElement]": {
            "type": "NORMAL_ID",
            "brief": "HUD元素",
            "description": "指定将被修改的HUD元素。",
            "ignoreError": true,
            "key": "hudElement"
        }
    }
}