{
    "name": [
        "gamerule"
    ],
    "description": "设置或查询游戏规则",
    "syntax": [
        "/gamerule",
        "/gamerule <rule: BoolGameRule> [value: Boolean]",
        "/gamerule <rule: IntGameRule> [value: int]"
    ],
    "node": {
        "[value: Boolean]": {
            "type": "BOOLEAN",
            "brief": "值",
            "description": "布尔型游戏规则的值",
            "descriptionFalse": "关闭该游戏规则",
            "descriptionTrue": "启用该游戏规则"
        },
        "[value: int]": {
            "type": "INTEGER",
            "brief": "值",
            "description": "整数型游戏规则的值"
        },
        "<rule: BoolGameRule>": {
            "type": "NORMAL_ID",
            "brief": "游戏规则",
            "description": "要设置或查询的布尔型游戏规则",
            "ignoreError": false,
            "key": "gameRuleBoolean"
        },
        "<rule: IntGameRule>": {
            "type": "NORMAL_ID",
            "brief": "游戏规则",
            "description": "要设置或查询的整数型游戏规则",
            "ignoreError": false,
            "key": "gameRuleInteger"
        }
    }
}