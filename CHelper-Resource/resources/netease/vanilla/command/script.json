{
    "name": [
        "script"
    ],
    "description": "管理GameTest调试、诊断和性能分析。",
    "syntax": [
        "/script debugger close",
        "/script debugger connect [host: string] [port: int]",
        "/script debugger listen <port: int>",
        "/script profiler start",
        "/script profiler stop",
        "/script watchdog exportstats"
    ],
    "node": {
        "debugger": {
            "type": "TEXT",
            "description": "调试器的连接、监听和关闭操作。",
            "data": {
                "name": "debugger",
                "description": "调试器的连接、监听和关闭操作。"
            }
        },
        "close": {
            "type": "TEXT",
            "description": "关闭调试器。",
            "data": {
                "name": "close",
                "description": "关闭调试器。"
            }
        },
        "connect": {
            "type": "TEXT",
            "description": "将调试器的指定端口连接至指定主机。",
            "data": {
                "name": "connect",
                "description": "将调试器的指定端口连接至指定主机。"
            }
        },
        "[host: string]": {
            "type": "STRING",
            "description": "指定主机的名称。",
            "canContainSpace": true,
            "ignoreLater": false,
            "brief": "主机的名称"
        },
        "[port: int]|<port: int>": {
            "type": "INTEGER",
            "brief": "调试器端口",
            "description": "指定调试器的端口。",
            "min": 1024,
            "max": 65535
        },
        "listen": {
            "type": "TEXT",
            "description": "监听调试器的指定端口。",
            "data": {
                "name": "listen",
                "description": "监听调试器的指定端口。"
            }
        },
        "profiler": {
            "type": "TEXT",
            "description": "启用或禁用跟踪脚本性能的分析器。",
            "data": {
                "name": "profiler",
                "description": "启用或禁用跟踪脚本性能的分析器。"
            }
        },
        "start": {
            "type": "TEXT",
            "description": "启用跟踪脚本性能的分析器。",
            "data": {
                "name": "start",
                "description": "启用跟踪脚本性能的分析器。"
            }
        },
        "stop": {
            "type": "TEXT",
            "description": "禁用跟踪脚本性能的分析器。",
            "data": {
                "name": "stop",
                "description": "禁用跟踪脚本性能的分析器。"
            }
        },
        "watchdog": {
            "type": "TEXT",
            "description": "导出内存和对象句柄统计。",
            "data": {
                "name": "watchdog",
                "description": "导出内存和对象句柄统计。"
            }
        },
        "exportstats": {
            "type": "TEXT",
            "description": "导出内存和对象句柄统计。",
            "data": {
                "name": "exportstats",
                "description": "导出内存和对象句柄统计。"
            }
        }
    }
}