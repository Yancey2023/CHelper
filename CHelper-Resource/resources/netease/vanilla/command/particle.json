{
    "name": [
        "particle"
    ],
    "description": "在指定位置显示粒子效果。",
    "syntax": [
        "/particle <effect: string> [position: x y z]"
    ],
    "node": {
        "<effect: string>": {
            "type": "NORMAL_ID",
            "brief": "粒子类型",
            "description": "选择要显示的粒子类型。",
