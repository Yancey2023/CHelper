{
    "name": [
        "stopsound"
    ],
    "description": "停止声音事件播放。",
    "syntax": [
        "/stopsound <player: target> [sound: string]"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "指定声音的接收者。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "声音的接收者"
        },
        "[sound: string]": {
            "type": "NORMAL_ID",
            "brief": "要停止的声音",
            "description": "指定要停止的声音事件。",
            "ignoreError": true,
            "key": "sound"
        }
    }
}