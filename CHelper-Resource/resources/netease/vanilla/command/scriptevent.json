{
    "name": [
        "scriptevent"
    ],
    "description": "通过ID和消息来触发脚本事件。",
    "syntax": [
        "/scriptevent <messageId: string> <message: message>"
    ],
    "node": {
        "<messageId: string>": {
            "type": "STRING",
            "brief": "触发脚本事件的消息ID",
            "description": "指定触发脚本事件的消息ID",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "<message: message>": {
            "type": "STRING",
            "brief": "触发脚本事件的消息",
            "description": "指定触发脚本事件的消息。",
            "canContainSpace": true,
            "ignoreLater": true
        }
    }
}