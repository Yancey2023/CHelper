{
    "name": [
        "time"
    ],
    "description": "控制或查询时间。",
    "syntax": [
        "/time add <amount: int>",
        "/time query <time: TimeQuery>",
        "/time set <amount: int>",
        "/time set <timeMarkerName: timemarker name>"
    ],
    "node": {
        "add": {
            "type": "TEXT",
            "description": "增加昼夜更替时间。",
            "data": {
                "name": "add",
                "description": "增加昼夜更替时间。"
            }
        },
        "<amount: int>": {
            "type": "INTEGER",
            "description": "指定要增加或设置的时间。 单位为游戏刻。",
            "brief": "要增加或设置的时间"
        },
        "query": {
            "type": "TEXT",
            "description": "查询当前经过的时间。",
            "data": {
                "name": "query",
                "description": "查询当前经过的时间。"
            }
        },
        "set": {
            "type": "TEXT",
            "description": "设置昼夜更替时间。",
            "data": {
                "name": "set",
                "description": "设置昼夜更替时间。"
            }
        },
        "<time: TimeQuery>": {
            "type": "NORMAL_ID",
            "description": "指定要查询的数据。",
            "ignoreError": false,
            "contents": [
                {
                    "name": "daytime",
                    "description": "当日时间"
                },
                {
                    "name": "gametime",
                    "description": "游戏时间"
                },
                {
                    "name": "day",
                    "description": "游戏天数"
                }
            ],
            "brief": "要查询的数据"
        },
        "<timeMarkerName: timemarker name>": {
            "type": "NORMAL_ID",
            "description": "指定要设置的时间标记。",
            "ignoreError": false,
            "contents": [
                {
                    "name": "day",
