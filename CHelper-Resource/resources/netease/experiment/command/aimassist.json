{
    "name": [
        "aimassist"
    ],
    "description": "修改玩家的瞄准辅助。",
    "syntax": [
        "/aimassist <player: target> clear",
        "/aimassist <player: target> set [xAngle: float] [yAngle: float] [maxDistance: float] [targetMode: string] [presetId: string]",
        "/aimassist <player: target> set [xAngle: float] [yAngle: float] [maxDistance: float] [targetMode: string]",
        "/aimassist <player: target> set [xAngle: float] [yAngle: float] [maxDistance: float]",
        "/aimassist <player: target> set [xAngle: float] [yAngle: float]",
        "/aimassist <player: target> set [xAngle: float]",
        "/aimassist <player: target> set"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "被修改瞄准辅助的玩家",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "clear": {
            "type": "TEXT",
            "description": "清除瞄准辅助",
            "data": {
                "name": "clear",
                "description": "清除瞄准辅助"
            }
        },
        "set": {
            "type": "TEXT",
            "description": "设定瞄准辅助",
            "data": {
                "name": "set",
                "description": "设定瞄准辅助"
            }
        },
        "[xAngle: float]": {
            "type": "FLOAT",
            "brief": "X轴角度",
            "description": "X轴角度",
            "min": 10,
            "max": 90
        },
        "[yAngle: float]": {
            "type": "FLOAT",
            "brief": "Y轴角度",
            "description": "Y轴角度",
            "min": 10,
            "max": 90
        },
        "[maxDistance: float]": {
            "type": "FLOAT",
            "brief": "最大距离",
            "description": "最大距离",
            "min": 1,
            "max": 16
        },
        "[targetMode: string]": {
            "type": "NORMAL_ID",
            "brief": "瞄准模式",
            "description": "瞄准模式",
            "ignoreError": true,
            "contents": [
                {
                    "name": "distance",
                    "description": "按距离选择目标"
                },
                {
                    "name": "angle",
                    "description": "按角度选择目标"
                }
            ]
        },
        "[presetId: string]": {
            "type": "STRING",
            "brief": "预设ID",
            "description": "预设ID",
            "canContainSpace": true,
            "ignoreLater": false
        }
    }
}