{
    "name": [
        "gamemode"
    ],
    "description": "设置玩家的游戏模式。",
    "syntax": [
        "/gamemode <gameMode: GameMode> [player: target]",
        "/gamemode <gameMode: int> [player: target]"
    ],
    "node": {
        "<gameMode: GameMode>|<gameMode: int>": {
            "type": "NORMAL_ID",
            "brief": "新游戏模式",
            "description": "指定玩家的新游戏模式",
            "ignoreError": true,
            "key": "gameMode"
        },
        "[player: target]": {
            "type": "TARGET_SELECTOR",
            "description": "指定要被修改游戏模式的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false,
            "brief": "要被修改游戏模式的玩家"
        }
    }
}