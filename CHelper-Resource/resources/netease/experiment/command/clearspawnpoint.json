{
    "name": [
        "clearspawnpoint"
    ],
    "description": "清除玩家的重生点。",
    "syntax": [
        "/clearspawnpoint [player: target]"
    ],
    "node": {
        "[player: target]": {
            "type": "TARGET_SELECTOR",
            "description": "指定被删除出生点的玩家。如果没有指定，默认为命令执行者。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        }
    }
}