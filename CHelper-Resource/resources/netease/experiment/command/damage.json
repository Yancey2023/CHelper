{
    "name": [
        "damage"
    ],
    "description": "对指定实体造成指定类型的伤害。",
    "syntax": [
        "/damage <target: target> <amount: int> <cause: DamageCause> entity <damager: target>",
        "/damage <target: target> <amount: int> [cause: DamageCause]"
    ],
    "node": {
        "<target: target>": {
            "type": "TARGET_SELECTOR",
            "description": "受到伤害的目标实体",
            "isOnlyOne": false,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<amount: int>": {
            "type": "INTEGER",
            "brief": "伤害值",
            "description": "造成的伤害值"
        },
        "[cause: DamageCause]": {
            "type": "NORMAL_ID",
            "description": "伤害的成因，决定造成的伤害类型",
            "ignoreError": true,
            "key": "damageCause"
        },
        "<cause: DamageCause>": {
            "type": "NORMAL_ID",
            "description": "伤害的成因，决定造成的伤害类型",
            "ignoreError": true,
            "key": "damageCause"
        },
        "entity": {
            "type": "TEXT",
            "description": "指定伤害来源实体",
            "data": {
                "name": "entity",
                "description": "指定伤害来源实体"
            }
        },
        "<damager: target>": {
            "type": "TARGET_SELECTOR",
            "description": "伤害的直接来源，可影响伤害造成的击退方向",
            "isOnlyOne": true,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false
        }
    }
}