{
    "name": [
        "inputpermission"
    ],
    "description": "对玩家的权限状态进行指定操作。",
    "syntax": [
        "/inputpermission query <targets: target> <permission: permission> [state: state]",
        "/inputpermission set <targets: target> <permission: permission> <state: state>"
    ],
    "node": {
        "query": {
            "type": "TEXT",
            "description": "查询玩家指定权限的当前状态。",
            "data": {
                "name": "query",
                "description": "查询玩家指定权限的当前状态"
            }
        },
        "<targets: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要查询或修改权限状态的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<permission: permission>": {
            "type": "NORMAL_ID",
            "brief": "操作所作用的权限",
            "description": "要查询或修改的玩家操作权限。",
            "ignoreError": true,
            "key": "inputPermission"
        },
        "[state: state]": {
            "type": "NORMAL_ID",
            "brief": "权限的状态",
            "description": "要查询的权限状态。",
            "ignoreError": true,
            "contents": [
                {
                    "name": "enabled",
                    "description": "允许玩家执行该操作。"
                },
                {
                    "name": "disabled",
                    "description": "禁止玩家执行该操作。"
                }
            ]
        },
        "set": {
            "type": "TEXT",
            "description": "修改玩家指定权限的状态。",
            "data": {
                "name": "set",
                "description": "修改玩家指定权限的状态"
            }
        },
        "<state: state>": {
            "type": "NORMAL_ID",
            "brief": "权限的状态",
            "description": "要设置的权限状态。",
            "ignoreError": true,
            "contents": [
                {
                    "name": "enabled",
                    "description": "允许玩家执行该操作。"
                },
                {
                    "name": "disabled",
                    "description": "禁止玩家执行该操作。"
                }
            ]
        }
    }
}