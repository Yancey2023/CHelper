{
    "name": [
        "gametest"
    ],
    "description": "管理和运行游戏测试框架",
    "syntax": [
        "/gametest clearall",
        "/gametest create <testName: string> [width: int] [height: int] [depth: int]",
        "/gametest pos",
        "/gametest run <testName: string> <stopOnFailure: Boolean> <repeatCount: int> [rotationSteps: int]",
        "/gametest run <testName: string> [rotationSteps: int]",
        "/gametest runset [tag: string] [rotationSteps: int]",
        "/gametest runsetuntilfail [tag: string] [rotationSteps: int]",
        "/gametest runthese",
        "/gametest runthis",
        "/gametest stopall"
    ],
    "node": {
        "clearall": {
            "type": "TEXT",
            "description": "清除所有的GameTest",
            "data": {
                "name": "clearall",
                "description": "清除所有的GameTest"
            }
        },
        "create": {
            "type": "TEXT",
            "description": "创建GameTest",
            "data": {
                "name": "create",
                "description": "创建GameTest"
            }
        },
        "<testName: string>": {
            "type": "STRING",
            "brief": "名称",
            "description": "GameTest的名称",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "[width: int]": {
            "type": "INTEGER",
            "description": "测试结构的X轴大小"
        },
        "[height: int]": {
            "type": "INTEGER",
            "description": "测试结构的Y轴大小"
        },
        "[depth: int]": {
            "type": "INTEGER",
            "description": "测试结构的Z轴大小"
        },
        "pos": {
            "type": "TEXT",
            "description": "在200格半径范围内寻找最近的GameTest结构方块",
            "data": {
                "name": "pos",
                "description": "在200格半径范围内寻找最近的GameTest结构方块"
            }
        },
        "run": {
            "type": "TEXT",
            "description": "执行一个特定的GameTest",
            "data": {
                "name": "run",
                "description": "执行一个特定的GameTest"
            }
        },
        "<stopOnFailure: Boolean>": {
            "type": "BOOLEAN",
            "brief": "失败停止",
            "description": "测试失败后是否停止后续测试",
            "descriptionTrue": "测试失败时停止后续测试",
            "descriptionFalse": "测试失败时继续执行其他测试"
        },
        "<repeatCount: int>": {
            "type": "INTEGER",
            "description": "重复次数",
            "min": 1
        },
        "[rotationSteps: int]": {
            "type": "INTEGER",
            "description": "指定测试结构的旋转角度"
        },
        "runset": {
            "type": "TEXT",
            "description": "创建和执行所有GameTest",
            "data": {
                "name": "runset",
                "description": "创建和执行所有GameTest"
            }
        },
        "[tag: string]": {
            "type": "STRING",
            "brief": "名称",
            "description": "要运行的游戏测试标签",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "runsetuntilfail": {
            "type": "TEXT",
            "description": "创建和执行所有GameTest，直到某个执行失败",
            "data": {
                "name": "runsetuntilfail",
                "description": "创建和执行所有GameTest，直到某个执行失败"
            }
        },
        "runthese": {
            "type": "TEXT",
            "description": "在200格半径范围内执行GameTest",
            "data": {
                "name": "runthese",
                "description": "在200格半径范围内执行GameTest"
            }
        },
        "runthis": {
            "type": "TEXT",
            "description": "执行或重新执行15格半径内的GameTest结构方块",
            "data": {
                "name": "runthis",
                "description": "执行或重新执行15格半径内的GameTest结构方块"
            }
        },
        "stopall": {
            "type": "TEXT",
            "description": "停止执行所有GameTest",
            "data": {
                "name": "stopall",
                "description": "停止执行所有GameTest"
            }
        }
    }
}