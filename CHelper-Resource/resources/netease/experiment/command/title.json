{
    "name": [
        "title"
    ],
    "description": "控制屏幕标题",
    "syntax": [
        "/title <player: target> <title|subtitle|actionbar> <titleText: message>",
        "/title <player: target> clear",
        "/title <player: target> reset",
        "/title <player: target> times <fadeIn: int> <stay: int> <fadeOut: int>"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要显示或清除屏幕标题的玩家",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<title|subtitle|actionbar>": {
            "type": "NORMAL_ID",
            "description": "标题文本的显示位置",
            "ignoreError": false,
            "contents": [
                {
                    "name": "title",
                    "description": "显示或替换主标题"
                },
                {
                    "name": "subtitle",
                    "description": "设置当前或下一条标题的副标题"
                },
                {
                    "name": "actionbar",
                    "description": "在动作栏上方显示文本"
                }
            ]
        },
        "<titleText: message>": {
            "type": "STRING",
            "brief": "文本",
            "description": "要显示的文本",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "clear": {
            "type": "TEXT",
            "description": "清除指定玩家屏幕标题",
            "data": {
                "name": "clear",
                "description": "清除指定玩家屏幕标题"
            }
        },
        "reset": {
            "type": "TEXT",
            "description": "重置指定玩家标题的淡入、停留和淡出时间",
            "data": {
                "name": "reset",
                "description": "重置指定玩家标题的淡入、停留和淡出时间"
            }
        },
        "times": {
            "type": "TEXT",
            "description": "更改指定玩家屏幕标题的淡入、持续、淡出时间",
            "data": {
                "name": "times",
                "description": "更改指定玩家屏幕标题的淡入、持续、淡出时间"
            }
        },
        "<fadeIn: int>": {
            "type": "INTEGER",
            "brief": "淡入时长",
            "description": "标题淡入时长（游戏刻）"
        },
        "<stay: int>": {
            "type": "INTEGER",
            "brief": "持续时长",
            "description": "标题停留时长（游戏刻）"
        },
        "<fadeOut: int>": {
            "type": "INTEGER",
            "brief": "淡出时长",
            "description": "标题淡出时长（游戏刻）"
        }
    }
}