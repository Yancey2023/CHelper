{
    "name": [
        "enchant"
    ],
    "description": "为一个实体手持的物品添加魔咒。受限于铁砧机制。",
    "syntax": [
        "/enchant <player: target> <enchantmentId: int> [level: int]",
        "/enchant <player: target> <enchantmentName: Enchant> [level: int]"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "目标实体",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<enchantmentId: int>": {
            "type": "INTEGER",
            "brief": "魔咒",
            "description": "要添加到目标手持物品上的魔咒"
        },
        "[level: int]": {
            "type": "INTEGER",
            "description": "魔咒等级",
            "min": 1
        },
        "<enchantmentName: Enchant>": {
            "type": "NORMAL_ID",
            "brief": "魔咒",
            "description": "指定要添加到实体主手持有物品上的魔咒。",
            "ignoreError": true,
            "key": "enchantType"
        }
    }
}