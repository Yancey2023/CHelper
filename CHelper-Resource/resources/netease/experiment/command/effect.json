{
    "name": [
        "effect"
    ],
    "description": "管理玩家及其他实体上的状态效果。",
    "syntax": [
        "/effect <player: target> <effect: Effect> [seconds: int] [amplifier: int] [hideParticles: Boolean]",
        "/effect <player: target> clear"
    ],
    "node": {
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "状态效果作用的目标实体",
            "isOnlyOne": false,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<effect: Effect>": {
            "type": "NORMAL_ID",
            "brief": "效果",
            "description": "要给予的状态效果",
            "ignoreError": true,
            "key": "effect"
        },
        "[seconds: int]": {
            "type": "INTEGER",
            "brief": "时长",
            "description": "效果持续时间"
        },
        "[amplifier: int]": {
            "type": "INTEGER",
            "brief": "等级",
            "description": "效果等级倍率"
        },
        "[hideParticles: Boolean]": {
            "type": "BOOLEAN",
            "brief": "是否隐藏药水粒子",
            "description": "隐藏状态效果的粒子和界面指示图标",
            "descriptionTrue": "隐藏状态效果的粒子和界面指示图标",
            "descriptionFalse": "显示状态效果的粒子和界面指示图标"
        },
        "clear": {
            "type": "TEXT",
            "description": "移除所有状态效果",
            "data": {
                "name": "clear",
                "description": "移除所有状态效果"
            }
        }
    }
}