{
    "name": [
        "playanimation"
    ],
    "description": "在一个或多个实体上播放一次性动画。",
    "syntax": [
        "/playanimation <entity: target> <animation: string> [next_state: string] [blend_out_time: float] [stop_expression: string] [controller: string]"
    ],
    "node": {
        "<entity: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要播放动画的实体。",
            "isOnlyOne": false,
            "isMustPlayer": false,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<animation: string>": {
            "type": "NORMAL_ID",
            "brief": "动画",
            "description": "要播放的动画。",
            "ignoreError": true,
            "key": "animation"
        },
        "[next_state: string]": {
            "type": "NORMAL_ID",
            "brief": "结束状态",
            "description": "动画结束后要切换到的状态。",
            "ignoreError": true,
            "key": "animationController"
        },
        "[blend_out_time: float]": {
            "type": "FLOAT",
            "brief": "渐变时间",
            "description": "动画退出时的渐变时长。"
        },
        "[stop_expression: string]": {
            "type": "STRING",
            "brief": "终止条件",
            "description": "停止动画播放的条件表达式。",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "[controller: string]": {
            "type": "STRING",
            "description": "使用的动画控制器。",
            "canContainSpace": true,
            "ignoreLater": false
        }
    }
}