{
    "name": [
        "kick"
    ],
    "description": "将玩家踢出服务器。",
    "syntax": [
        "/kick <name: target> <reason: message>"
    ],
    "node": {
        "<name: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要踢出的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<reason: message>": {
            "type": "STRING",
            "description": "显示给被踢出玩家的原因消息。",
            "canContainSpace": true,
            "ignoreLater": true
        }
    }
}