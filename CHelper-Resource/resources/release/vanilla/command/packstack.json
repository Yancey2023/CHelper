{
    "name": [
        "packstack"
    ],
    "description": "显示资源包、行为包和脚本模块数据。",
    "syntax": [
        "/packstack <stackType: stackType> [verbose: verbose] [exclude-vanilla: exclude-vanilla]"
    ],
    "node": {
        "<stackType: stackType>": {
            "type": "NORMAL_ID",
            "description": "选择要显示的包类型。",
            "ignoreError": false,
            "contents": [
                {
                    "name": "client",
                    "description": "显示资源包相关数据。"
                },
                {
                    "name": "server",
                    "description": "显示行为包和脚本模块数据。"
                }
            ]
        },
        "[verbose: verbose]": {
            "type": "TEXT",
            "description": "显示未启用的包及包的详细信息。",
            "data": {
                "name": "verbose",
                "description": "显示未启用的包及包的详细信息。"
            }
        },
        "[exclude-vanilla: exclude-vanilla]": {
            "type": "TEXT",
            "description": "从显示结果中排除原版包。",
            "data": {
                "name": "exclude-vanilla",
                "description": "从显示结果中排除原版包。"
            }
        }
    }
}