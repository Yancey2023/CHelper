{
    "name": [
        "dialogue"
    ],
    "description": "为玩家打开或改变NPC的对话框。",
    "syntax": [
        "/dialogue change <npc: target> <sceneName: string> [players: target]",
        "/dialogue open <npc: target> <player: target> [sceneName: string]"
    ],
    "node": {
        "change": {
            "type": "TEXT",
            "description": "通过场景文件改变NPC的对话。",
            "data": {
                "name": "change",
                "description": "通过场景文件改变NPC的对话。"
            }
        },
        "<npc: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要打开或改变对话的NPC",
            "isOnlyOne": true,
            "isMustPlayer": false,
            "isMustNPC": true,
            "isWildcard": false
        },
        "<sceneName: string>|[sceneName: string]": {
            "type": "STRING",
            "brief": "场景名",
            "description": "要使用的NPC对话场景",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "[players: target]": {
            "type": "TARGET_SELECTOR",
            "description": "要修改该NPC对话的玩家；未指定时修改该NPC的全局对话",
            "isOnlyOne": true,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "open": {
            "type": "TEXT",
            "description": "打开NPC的对话，或以该NPC为活动对象进行场景对话。",
            "data": {
                "name": "open",
                "description": "打开NPC的对话，或以该NPC为活动对象进行场景对话。"
            }
        },
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "打开NPC对话框的目标玩家",
            "isOnlyOne": true,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        }
    }
}