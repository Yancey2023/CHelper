{
    "name": [
        "weather"
    ],
    "description": "更改或查询游戏天气",
    "syntax": [
        "/weather <clear|rain|thunder> [duration: int]",
        "/weather query"
    ],
    "node": {
        "<clear|rain|thunder>": {
            "type": "NORMAL_ID",
            "description": "天气",
            "ignoreError": false,
            "contents": [
                {
                    "name": "clear",
                    "description": "将天气设为晴天"
                },
                {
                    "name": "rain",
                    "description": "将天气设为雨天（寒冷的生物群系会下雪）"
                },
                {
                    "name": "thunder",
                    "description": "将天气设为雷暴雨（寒冷的生物群系会下雷暴雪）"
                }
            ]
        },
        "[duration: int]": {
            "type": "INTEGER",
            "brief": "持续时间",
            "description": "天气持续的游戏刻数",
            "min": 0,
            "max": 1000000
        },
        "query": {
            "type": "TEXT",
            "description": "查询当前天气",
            "data": {
                "name": "query",
                "description": "查询当前天气"
            }
        }
    }
}