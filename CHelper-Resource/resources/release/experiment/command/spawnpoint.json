{
    "name": [
        "spawnpoint"
    ],
    "description": "为玩家设置个人重生点。",
    "syntax": [
        "/spawnpoint [player: target] [spawnPos: x y z]"
    ],
    "node": {
        "[player: target]": {
            "type": "TARGET_SELECTOR",
            "description": "选择要设置个人重生点的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "[spawnPos: x y z]": {
            "type": "POSITION",
            "brief": "出生坐标",
            "description": "指定该玩家的个人重生点坐标。"
        }
    }
}