{
    "name": [
        "schedule"
    ],
    "description": "安排函数在特定的游戏刻后运行。",
    "syntax": [
        "/schedule clear <function: filepath>",
        "/schedule delay add <function: filepath> <time: int> [replace|append]",
        "/schedule delay add <function: filepath> <time: int>D [replace|append]",
        "/schedule delay add <function: filepath> <time: int>S [replace|append]",
        "/schedule delay add <function: filepath> <time: int>T [replace|append]",
        "/schedule delay clear <function: filepath>",
        "/schedule on_area_loaded add <from: x y z> <to: x y z> <function: filepath>",
        "/schedule on_area_loaded add circle <center: x y z> <radius: int> <function: filepath>",
        "/schedule on_area_loaded add tickingarea <name: string> <function: filepath>",
        "/schedule on_area_loaded clear function <function: filepath>",
        "/schedule on_area_loaded clear tickingarea <name: string> [function: filepath]"
    ],
    "node": {
        "clear": {
            "type": "TEXT",
            "description": "将之前指定的函数从计划中移除。",
            "data": {
                "name": "clear",
                "description": "将之前指定的函数从计划中移除。"
            }
        },
        "<function: filepath>": {
            "type": "STRING",
            "brief": "函数",
            "description": "指定要计划运行的函数。",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "delay": {
            "type": "TEXT",
            "description": "将指定函数延时运行。",
            "data": {
                "name": "delay",
                "description": "将指定函数延时运行。"
            }
        },
        "add": {
            "type": "TEXT",
            "description": "添加函数计划。",
            "data": {
                "name": "add",
                "description": "添加函数计划。"
            }
        },
        "<time: int>D|<time: int>S|<time: int>T|<time: int>": {
            "type": "INTEGER",
            "brief": "时间",
            "description": "指定等待的时间。为0时执行失败。",
            "ignoreLater": true,
            "units": [
                {
                    "name": "D",
                    "description": "按游戏日计时。"
                },
                {
                    "name": "S",
                    "description": "按秒计时。"
                },
                {
                    "name": "T",
                    "description": "按游戏刻计时。"
                },
                {
                    "name": "d",
                    "description": "按游戏日计时。"
                },
                {
                    "name": "s",
                    "description": "按秒计时。"
                },
                {
                    "name": "t",
                    "description": "按游戏刻计时。"
                }
            ]
        },
        "[replace|append]": {
            "type": "NORMAL_ID",
            "description": "指定是否取代还在等待执行的函数或函数标签。",
            "ignoreError": false,
            "contents": [
                {
                    "name": "replace",
                    "description": "（默认值）取代此函数或函数标签的现有计划。"
                },
                {
                    "name": "append",
                    "description": "为此函数或函数标签添加新的计划。"
                }
            ]
        },
        "on_area_loaded": {
            "type": "TEXT",
            "description": "当指定区域被加载后，执行所计划的函数。",
            "data": {
                "name": "on_area_loaded",
                "description": "当指定区域被加载后，执行所计划的函数。"
            }
        },
        "<from: x y z>": {
            "type": "POSITION",
            "brief": "坐标1",
            "description": "指定用于定义矩形加载区域的两个对角坐标。"
        },
        "<to: x y z>": {
            "type": "POSITION",
            "brief": "坐标2",
            "description": "指定用于定义矩形加载区域的两个对角坐标。"
        },
        "circle": {
            "type": "TEXT",
            "description": "按圆心和半径定义加载区域。",
            "data": {
                "name": "circle",
                "description": "按圆心和半径定义加载区域。"
            }
        },
        "<center: x y z>": {
            "type": "POSITION",
            "brief": "中心坐标",
            "description": "指定用于定义圆形加载区域的圆心的坐标。"
        },
        "<radius: int>": {
            "type": "INTEGER",
            "brief": "半径",
            "description": "指定圆形常加载区域的半径作为从中心到圆周的区块数。"
        },
        "tickingarea": {
            "type": "TEXT",
            "description": "当此常加载区域被添加时执行函数。",
            "data": {
                "name": "tickingarea",
                "description": "当此常加载区域被添加时执行函数。"
            }
        },
        "<name: string>": {
            "type": "STRING",
            "brief": "常加载区域名称",
            "description": "指定常加载区域的名称。",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "[function: filepath]": {
            "type": "STRING",
            "brief": "函数",
            "description": "指定要计划运行的函数。",
            "canContainSpace": true,
            "ignoreLater": false
        },
        "function": {
            "type": "TEXT",
            "description": "清除指定函数的计划。",
            "data": {
                "name": "function",
                "description": "清除指定函数的计划。"
            }
        }
    }
}