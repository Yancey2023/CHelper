{
    "name": [
        "recipe"
    ],
    "description": "给予玩家或收回玩家的配方解锁。",
    "syntax": [
        "/recipe give <player: target> <recipe: string>",
        "/recipe take <player: target> <recipe: string>"
    ],
    "node": {
        "give": {
            "type": "TEXT",
            "description": "为玩家解锁指定配方。",
            "data": {
                "name": "give",
                "description": "为玩家解锁指定配方。"
            }
        },
        "<player: target>": {
            "type": "TARGET_SELECTOR",
            "description": "要接收或失去配方的玩家。",
            "isOnlyOne": false,
            "isMustPlayer": true,
            "isMustNPC": false,
            "isWildcard": false
        },
        "<recipe: string>": {
            "type": "NORMAL_ID",
            "description": "要解锁或收回的配方。",
            "ignoreError": true,
            "key": "recipe"
        },
        "take": {
            "type": "TEXT",
            "description": "收回玩家的指定配方解锁。",
            "data": {
                "name": "take",
                "description": "收回玩家的指定配方解锁。"
            }
        },
        "*": {
            "type": "TEXT",
            "description": "指定配方操作作用于全部配方。",
            "data": {
                "name": "*",
                "description": "指定配方操作作用于全部配方。"
            }
        }
    }
}