{
    "name": [
        "packstack"
    ],
    "description": "显示已加载的资源包、行为包和脚本模块。",
    "syntax": [
        "/packstack <stackType: stackType> [verbose: verbose] [exclude-vanilla: exclude-vanilla]"
    ],
    "node": {
        "<stackType: stackType>": {
            "type": "NORMAL_ID",
            "description": "指定包的类型",
            "ignoreError": false,
            "contents": [
                {
                    "name": "client",
                    "description": "资源包"
                },
                {
                    "name": "server",
                    "description": "行为包和脚本模块"
                }
            ],
            "brief": "包的类型"
        },
        "[verbose: verbose]": {
            "type": "TEXT",
            "description": "显示未启用的包和包详情。",
            "data": {
                "name": "verbose",
                "description": "显示未启用的包和包详情。"
            },
            "brief": "显示未启用包和详细信息"
        },
        "[exclude-vanilla: exclude-vanilla]": {
            "type": "TEXT",
            "description": "从结果中排除原版包。",
            "data": {
                "name": "exclude-vanilla",
                "description": "从结果中排除原版包。"
            },
            "brief": "排除原版包"
        }
    }
}