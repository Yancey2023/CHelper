{
  // ===== 第二条命令：演示"目标选择器"参数 =====
  "name": [
    "grant"          // 注册 /grant（进服务器后可自定义为任意权限动作）
  ],
  "description": "向目标授予模板头衔（模板：TARGET_SELECTOR 参数）",

  "syntax": [
    "/grant <target: target>",  // 目标选择器参数
    "/grant all"
  ],

  "node": {
    "<target: target>": {         // 键与 syntax 占位符一致
      "type": "TARGET_SELECTOR",  // 值 = 目标选择器，如 @a[scores={...}]；补全/校验内核内置
      "description": "授予对象（选择器）",
      "isOnlyOne": false,         // false=允许多个目标（@a/@e）；true=仅单个（@p/@s）
      "isMustPlayer": true,       // 是否只允许玩家（@a/@p/@r/@s）
      "isMustNPC": false,         // 是否必须为 NPC（@initiator 场景）
      "isWildcard": false         // 是否允许使用 *（未实现的规划字段按 false 声明）
    },
    "all": {
      "type": "TEXT",
      "description": "授予所有玩家",
      "data": {
        "name": "all",
        "description": "授予所有玩家"
      }
    }
  }
}
